# Supabase (browser-safe values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only (never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # only if server code needs admin access

# Server-side secrets (stored in the hosted backend secret store, never committed).
# The generated .env only carries the Supabase values above; anything below is
# injected at runtime by the platform, so it is normal for it not to appear there.
# EMAIL_SETTINGS_ENC_KEY=your-shared-encryption-key   # configured
# CRON_SECRET=random-32-char-string                   # configured (generated)
# PAYSTACK_SECRET_KEY=your-paystack-secret-key        # added later from admin
# PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret # added later from admin

# Google reviews sync. Business Profile gives full owned-location review access.
# Places API is a lighter fallback that can update the public rating/count and
# import the limited review sample returned by Google Places.
# GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=oauth-access-token-with-business.manage-scope
# GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=123456789
# GOOGLE_BUSINESS_PROFILE_LOCATION_ID=987654321
# GOOGLE_PLACES_API_KEY=your-google-cloud-api-key     # server key with Places API enabled

# Sentry error monitoring
# VITE_SENTRY_DSN=your-public-sentry-dsn
# SENTRY_DSN=your-server-sentry-dsn
# VITE_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=talk-space@commit-sha
# SENTRY_RELEASE=talk-space@commit-sha
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# SENTRY_ENABLE_LOGS=false
#
# Build-time source-map upload. Store these only in local/CI/Vercel secrets.
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-build-token
